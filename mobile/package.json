{
  "name": "map-to-gpx-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Map to GPX for iOS and Android: the web app's own core and engine in a Capacitor shell.",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "dev": "node scripts/build-www.mjs && node scripts/dev.mjs",
    "sync": "npm run build && npx cap sync",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android",
    "test": "node --test 'test/*.test.mjs'"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capgo/capacitor-share-target": "8.0.54",
    "@fontsource-variable/inter": "5.3.0",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}

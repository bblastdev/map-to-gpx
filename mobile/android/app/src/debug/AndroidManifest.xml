<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets a development bundle (MTG_API, see
     scripts/build-www.mjs) reach a dev server on this computer over plain
     http. Release builds keep Android's default of https only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config_debug" />
</manifest>
